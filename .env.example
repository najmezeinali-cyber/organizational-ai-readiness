# Local development defaults. Copy to .env.local; never commit secrets.
APP_URL=http://localhost:3000
MAIL_MODE=file
DATA_DIR=.data
# Production: MAIL_MODE=smtp, HTTPS origin, persistent DATA_DIR, strong secret required.
# APP_SECRET=generate-a-random-secret-at-least-32-characters
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=AI Readiness <no-reply@example.com>
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
